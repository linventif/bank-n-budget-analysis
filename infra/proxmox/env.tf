# Builds the .env pushed to /opt/<app_name>/.env in the CT. It is both the Compose interpolation file
# (IMAGE_TAG, COMPOSE_PROFILES, …) and what services load with `env_file: .env`.
#
# Precedence, lowest to highest:
#   generated secrets  <  var.env_file  <  var.app_env  <  keys driven by Terraform variables

resource "random_password" "generated" {
  for_each = var.generated_secrets
  length   = each.value
  special  = false
}

locals {
  generated_env = { for k, r in random_password.generated : k => r.result }

  # KEY=value lines of var.env_file. Values are kept raw (quotes, inline comments) so Compose parses them
  # exactly as it would have parsed the original file. `export KEY=` accepted. Last occurrence wins.
  env_file_entries = [
    for line in split("\n", replace(var.env_file == null ? "" : sensitive(file(var.env_file)), "\r", "")) :
    regex("^\\s*(?:export\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(.*?)\\s*$", line)
    if can(regex("^\\s*(?:export\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*=", line))
  ]
  env_file_vars = { for k, vs in { for e in local.env_file_entries : e[0] => e[1]... } : k => vs[length(vs) - 1] }

  # Keys driven by Terraform variables: they always win.
  deployment_env = merge(local.bks_env, {
    IMAGE_TAG        = var.image_tag
    COMPOSE_PROFILES = join(",", concat(var.compose_profiles, var.cloudflare_tunnel_token == null ? [] : ["tunnel"]))
  })

  env = merge(local.generated_env, local.env_file_vars, var.app_env, local.deployment_env)

  env_content = join("", concat(
    ["# Generated by Terraform (infra/proxmox/env.tf). Edit the Terraform inputs, not this file.\n"],
    [for k in sort(keys(local.env)) : "${k}=${local.env[k]}\n"],
  ))

  # Separate file: the tunnel token never reaches the app containers.
  cloudflared_env = var.cloudflare_tunnel_token == null ? "# no tunnel configured\n" : "TUNNEL_TOKEN=${var.cloudflare_tunnel_token}\n"

  # Validation runs on what the user supplied (known at plan time): generated values are always present and
  # long enough. Only key names leave the sensitive context.
  env_supplied = merge(local.env_file_vars, var.app_env, local.deployment_env)
  env_supplied_value = {
    for k, v in local.env_supplied : k => trimspace(trim(v, "\"'"))
  }
  env_missing_keys = nonsensitive(sort([
    for k in var.required_env_keys : k
    if !contains(keys(var.generated_secrets), k) && lookup(local.env_supplied_value, k, "") == ""
  ]))
  env_placeholder_keys = nonsensitive(sort([
    for k, v in local.env_supplied_value : k
    if contains([for p in var.placeholder_values : upper(p)], upper(v))
  ]))
  env_weak_keys = nonsensitive(sort([
    for k in var.strong_secret_keys : k
    if contains(keys(local.env_supplied_value), k) && length(lookup(local.env_supplied_value, k, "")) < var.min_secret_length
  ]))
}
