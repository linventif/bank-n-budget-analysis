# cp terraform.tfvars.example terraform.tfvars   (gitignoré)
# TF_VAR_proxmox_api_token vient de ~/.zshenv. NE PAS compter sur TF_VAR_cloudflare_tunnel_token (voir plus bas).
# Clés de marché : ici, ou TF_VAR_market_fred_key / TF_VAR_market_alphavantage_key.

app_name = "bks"

###############################################################################
# Proxmox (pve-colloc). SSH : cloudflared access tcp --hostname pve-colloc.linv.dev/ssh --url 127.0.0.1:2222
###############################################################################
proxmox_endpoint = "https://pve-colloc.linv.dev/"
node_name        = "pve-colloc"
ssh_host         = "127.0.0.1"
ssh_port         = 2222

# Partagés, gérés par l'état de gmod-integration : seulement référencés.
datastore_id     = "dir-gmi"
bridge           = "vmbr1"
bridge_address   = "10.10.10.1/24"
template_file_id = "dir-gmi:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst"

###############################################################################
# Conteneur — id/IP libres (pct list ; pvesh get /cluster/nextid). Convention : IP .(vm_id - 90)
###############################################################################
vm_id             = 111
ipv4_address      = "10.10.10.21/24"
cores             = 1
memory_mb         = 1024
swap_mb           = 512
rootfs_size_gb    = 8
data_disk_size_gb = 8 # images + base SQLite (quelques Mo)
# protection      = true
# backup_storage  = "local"   # vzdump nocturne, FORTEMENT conseillé : la base n'existera plus que là

###############################################################################
# Stack
###############################################################################
compose_file         = "../../compose.yml"
auto_update_services = ["bks"]
# image_tag          = "sha-<commit>"   # épingler / revenir en arrière

public_hostnames = {
  "bks.example.com" = "http://localhost:9889"
}
# Jeton du tunnel PROPRE à bks (obligatoire ici) : le TF_VAR_cloudflare_tunnel_token de ~/.zshenv est le
# tunnel d'un autre projet et serait pris en silence si cette ligne manquait. Vide = le plan échoue.
cloudflare_tunnel_token = ""

###############################################################################
# Application (rendue en config.toml par bks.tf)
###############################################################################
public_url          = "https://bks.example.com"
legal_contact_email = "contact@exemple.fr"

eb_app_id           = "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
eb_private_key_file = "/home/me/.config/bank-analysis/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee.pem" # hors du dépôt
eb_countries        = ["FR"]
# eb_auto_sync_hours = 8

# ai = { provider = "ollama", url = "http://10.10.10.x:11434", model = "qwen3:4b" }   # null = désactivée

# admin_access = true   # 9890 joignable depuis l'hôte Proxmox seulement (tunnel SSH)
