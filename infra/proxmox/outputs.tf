output "container_vm_id" {
  value = proxmox_virtual_environment_container.app.vm_id
}

output "container_ip" {
  value = local.container_ip
}

output "tunnel_public_hostnames" {
  description = "Public hostnames to configure on the Cloudflare Tunnel, and the local service each one targets."
  value       = var.public_hostnames
}

output "ops" {
  description = "Day-to-day commands, run from this machine."
  value = {
    status = "ssh -p ${var.ssh_port} root@${var.ssh_host} pct exec ${var.vm_id} -- ${var.app_name}ctl status"
    logs   = "ssh -t -p ${var.ssh_port} root@${var.ssh_host} pct exec ${var.vm_id} -- ${var.app_name}ctl logs"
    update = "ssh -p ${var.ssh_port} root@${var.ssh_host} pct exec ${var.vm_id} -- ${var.app_name}ctl update"
    shell  = "ssh -t -p ${var.ssh_port} root@${var.ssh_host} pct enter ${var.vm_id}"
    # Interface locale (gestion des passkeys) : laisser tourner, puis ouvrir http://localhost:9890
    admin = var.admin_access ? "ssh -N -p ${var.ssh_port} -L 9890:${local.container_ip}:9890 root@${var.ssh_host}" : "désactivé (admin_access = false)"
    # Importer une base : voir docs/deployment/proxmox.md (« Migrer la base »)
    import_db = "ssh -p ${var.ssh_port} root@${var.ssh_host} 'pct push ${var.vm_id} /root/bks-import.db /root/bks-import.db --perms 0600 && rm /root/bks-import.db && pct exec ${var.vm_id} -- ${var.app_name}ctl import-db /root/bks-import.db'"
  }
}

output "generated_secrets" {
  description = "Secrets generated by Terraform (unless overridden). terraform output -json generated_secrets"
  sensitive   = true
  value       = { for k in keys(var.generated_secrets) : k => local.env[k] }
}
